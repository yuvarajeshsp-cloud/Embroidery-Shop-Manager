{
  "name": "shop-manager-desktop",
  "productName": "Thiyal Desk",
  "version": "3.1.0",
  "description": "Thiyal Desk — Business Management System for Windows and Mac",
  "author": "Paavai Embroidery",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare-app": "cd .. && npm run build && rm -rf desktop/app && cp -R dist desktop/app",
    "dist:mac": "npm run prepare-app && electron-builder --mac",
    "dist:win": "npm run prepare-app && electron-builder --win",
    "dist": "npm run prepare-app && electron-builder --mac --win",
    "dist:win:signed": "npm run prepare-app && CSC_LINK=\"$PWD/signing/shop-manager-test.pfx\" CSC_KEY_PASSWORD=\"$(cat signing/password.txt)\" electron-builder --win"
  },
  "build": {
    "appId": "com.rkapps.thiyaldesk",
    "productName": "Thiyal Desk",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "chooser.html",
      "app/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Thiyal Desk uses Bluetooth to connect to your receipt printer.",
        "NSBluetoothPeripheralUsageDescription": "Thiyal Desk uses Bluetooth to connect to your receipt printer."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signtoolOptions": {
        "publisherName": "Paavai Embroidery",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  }
}
